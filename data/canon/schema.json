{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DrFlGd/DCC-Game/data/canon/schema.json",
  "title": "DCC Game canon catalogue",
  "description": "Source-checked observations from the books, kept separate from gameplay content. See docs/research/CATALOG_GUIDE.md. Records whose id starts with example_ are shape examples and must be ignored by every tool.",
  "type": "object",
  "required": ["schema_version", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "category",
        "source_book", "source_chapter_or_scene",
        "spoiler_level", "source_confidence",
        "participants", "context", "observed_behavior",
        "gameplay_candidate", "adaptation_type",
        "tags", "notes", "review_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable key: <category>_<slug>. The prefix example_ marks a non-canon shape example.",
          "pattern": "^(example_)?(encounter|enemy|weapon|item|spell|skill|companion_action|environment|system_rule|achievement|other)_[a-z0-9_]{2,60}$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": {
          "enum": ["encounter", "enemy", "weapon", "item", "spell", "skill", "companion_action", "environment", "system_rule", "achievement", "other"]
        },
        "source_book": {
          "type": "integer", "minimum": 1,
          "description": "Book number in series publication order, as listed in docs/research/SOURCE_INDEX.md."
        },
        "source_chapter_or_scene": {
          "type": "string",
          "description": "Chapter-level citation: C<number>, PRO (prologue), EPI (epilogue) or INT<n> (interlude), optionally followed by ': ' and a short scene label in your own words.",
          "pattern": "^(C[0-9]{1,3}|PRO|EPI|INT[0-9]{0,2})(: .{1,80})?$"
        },
        "spoiler_level": { "enum": ["none", "minor", "major", "ending"] },
        "source_confidence": { "enum": ["high", "medium", "low"] },
        "participants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 60 },
          "description": "Who is involved. Research data only; never copied into game content."
        },
        "context": { "type": "string", "maxLength": 400 },
        "observed_behavior": {
          "type": "string", "minLength": 1, "maxLength": 600,
          "description": "What the source establishes, summarised in your own words. No quotations longer than a short phrase."
        },
        "gameplay_candidate": {
          "type": ["string", "null"], "maxLength": 600,
          "description": "Proposed mechanic or content translation, or null if none."
        },
        "adaptation_type": { "enum": ["canon", "adapted", "original"] },
        "floor_or_depth": { "type": ["integer", "null"], "minimum": 1 },
        "combat_role": {
          "enum": [null, "chaser", "ranged", "charger", "zoner", "summoner", "tank", "support", "trap", "elite", "miniboss", "boss"]
        },
        "status_effects": { "type": "array", "items": { "type": "string" } },
        "gameplay_suitability": { "enum": ["high", "medium", "low", "unsuitable"] },
        "related_ids": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_:-]+$" } },
        "notes": { "type": "string", "maxLength": 1000 },
        "review_status": { "enum": ["draft", "needs_source", "in_review", "reviewed", "disputed", "example"] },
        "reviewed_by": { "type": "string" },
        "last_reviewed": { "type": "string", "format": "date" }
      },
      "allOf": [
        {
          "if": { "properties": { "review_status": { "const": "example" } } },
          "then": { "properties": { "id": { "pattern": "^example_" } } }
        },
        {
          "if": { "properties": { "id": { "pattern": "^example_" } } },
          "then": { "properties": { "review_status": { "const": "example" } } }
        },
        {
          "if": { "properties": { "review_status": { "const": "reviewed" } } },
          "then": { "required": ["reviewed_by", "last_reviewed"] }
        }
      ]
    }
  }
}
